*.app

# 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 本地工具与下载缓存（体积大，可重新获取）
tools/downloads/
tools/AndroidSdk/
tools/jdk17/
tools/UnityEditor/
tools/UnityHub/
tools/Blender/

# Blender 生成物
Blender/*.blend1
Blender/*.blend2

# 操作系统与编辑器
.DS_Store
Thumbs.db
desktop.ini

# IDE 插件生成的跨项目追踪文件，内容与本项目无关
.ai-code-tracking.json
